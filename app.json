{
  "expo": {
    "name": "care-app",
    "slug": "care-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "careapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "tw.edu.ncnu.omnicare",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "需要存取相簿，讓你在照顧者交流與聊天室中分享照片",
          "cameraPermission": "需要使用相機，讓你拍攝藥單或照護照片"
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "prescriptionApiBaseUrl": "http://13.115.221.47:8080",
      "allowInsecurePrescriptionApi": true,
      "eas": {
        "projectId": "dee016b6-26d0-49fd-bb06-5cc9343b4575"
      }
    },
    "owner": "bocheng907"
  }
}
